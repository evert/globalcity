{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 160,
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": ["client/dist/", "dist/", "data/", "client/public/assets/", "art/", "android/", "LICENSES/", "package-lock.json", "*.yml", "*.yaml"]
}
